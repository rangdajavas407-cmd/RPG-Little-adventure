; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Janji untuk Adek"
run/main_scene="res://screens/game/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="JanjiUntukAdekFresh"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.964706, 0.4, 0.00784314, 1)
boot_splash/use_filter=false
boot_splash/image="res://screens/game/boot/logodupot.png"
config/icon="res://icon.png"
boot_splash/stretch_mode=0

[autoload]

GlobalPlayer="*res://common/singletons/globalPlayer.gd"
GlobalGame="*res://common/singletons/globalGame.gd"
GlobalItems="*res://common/singletons/globalItems.gd"
GlobalScenes="*res://common/singletons/globalScenes.gd"
GlobalVersion="*res://common/singletons/globalVersion.gd"
SceneTransition="*res://common/singletons/sceneTransition.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[dotnet]

project/assembly_name="Janji untuk Kakak"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": true,
"process/premult_alpha": false
}

